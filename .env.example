# Copia questo file in ".env" per provare il sito sul tuo computer.
# Su Railway queste cose si impostano dalla scheda "Variables" del servizio (NON caricare mai .env su GitHub).

# Obbligatorie su Railway
SECRET_KEY=metti-una-stringa-lunga-e-casuale
ADMIN_PASSWORD=scegli-una-password-lunga
# DATABASE_URL la fornisce Railway collegando il database PostgreSQL

# Facoltative
ADMIN_USERNAME=dalia
SITE_URL=https://www.tuodominio.it
FACEBOOK_URL=
# Email di avviso per le richieste dal modulo contatti (facoltative)
# Su Railway (piani Free/Hobby) la posta SMTP è bloccata: usa Resend (resend.com), che invia via web.
MAIL_TO=indirizzo-di-dalia@esempio.it
RESEND_API_KEY=
MAIL_FROM=Daliamae <onboarding@resend.dev>
# Solo piano Railway Pro o oltre (alternativa a Resend):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Newsletter con Mailchimp (facoltativa). Funziona anche sul piano Hobby di Railway.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
